{
  "patchbay": "0.1",
  "id": "tools.patchbay.dsprsn",
  "name": "DSPRSN",
  "version": "1.0.0",
  "description": "Spektrale Dispersion wie im Prisma",
  "entry": "./",
  "accepts": ["image/*"],
  "produces": ["image/png"],
  "modes": ["headless", "embedded", "standalone"],
  "deterministic": true,
  "op": "transform",
  "repro": "exact",
  "color": "#7C5CFF",
  "params": [
    { "id": "spread", "type": "number", "label": "Dispersion", "min": 0, "max": 2, "step": 0.01, "default": 1.31 },
    { "id": "warp_strength", "type": "number", "label": "Verzerrung", "min": 0, "max": 1, "step": 0.01, "default": 0.63 },
    { "id": "warp_type", "type": "enum", "label": "Art", "options": ["Fluid", "Turbulence", "Swirl", "Ripple", "Shatter", "Vortex", "Wave", "Pinch", "Kaleidoscope", "Spiral", "Glitch", "Melt", "Explode", "Twist", "Fisheye"], "default": "Wave" },
    { "id": "warp_complexity", "type": "int", "label": "Komplexität", "min": 1, "max": 6, "step": 1, "default": 5 },
    { "id": "warp_scale", "type": "number", "label": "Maßstab", "min": 0.1, "max": 10, "step": 0.1, "default": 1.2 },
    { "id": "phase", "type": "number", "label": "Phase", "min": 0, "max": 20, "step": 0.05, "default": 3.2 },
    { "id": "warp_speed", "type": "number", "label": "Tempo", "min": 0, "max": 5, "step": 0.1, "default": 3.9 },
    { "id": "warp_symmetry", "type": "int", "label": "Symmetrie", "min": 1, "max": 12, "step": 1, "default": 2 },
    { "id": "warp_decay", "type": "number", "label": "Randabfall", "min": 0, "max": 1, "step": 0.01, "default": 0.11 },
    { "id": "warp_blend", "type": "number", "label": "Mischung", "min": 0, "max": 1, "step": 0.01, "default": 1 },
    { "id": "dir_x", "type": "number", "label": "Richtung X", "min": -1, "max": 1, "step": 0.01, "default": 0.5 },
    { "id": "dir_y", "type": "number", "label": "Richtung Y", "min": -1, "max": 1, "step": 0.01, "default": 0.52 },
    { "id": "mode", "type": "enum", "label": "Spektrum", "options": ["RGB", "CMY"], "default": "RGB" },
    { "id": "samples", "type": "int", "label": "Farbproben", "min": 4, "max": 24, "step": 2, "default": 10 },
    { "id": "grain", "type": "number", "label": "Korn", "min": 0, "max": 0.5, "step": 0.01, "default": 0.08 },
    { "id": "seed", "type": "seed", "label": "Seed", "default": 7 }
  ],
  "license": "MIT",
  "credits": "Effekt ursprünglich erstellt mit Brik (brik.space), für Patchbay portiert",
  "homepage": "https://github.com/VVVRGIT/patchbay/tree/main/tools/dsprsn"
}
